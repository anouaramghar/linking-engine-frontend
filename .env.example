# Keep API calls same-origin so Vite (development) or the web server (deployment)
# can proxy them to the backend without browser CORS configuration.
VITE_API_BASE_URL=/api

# Server-side proxy settings. LINKMESH_API_KEY must never use the VITE_ prefix:
# Vite exposes every VITE_ variable to browser JavaScript.
BACKEND_URL=http://127.0.0.1:8000
# Required and non-empty when running the production nginx image.
LINKMESH_API_KEY=

# Optional space-separated Host names the production nginx server block accepts
# in addition to localhost and 127.0.0.1 (for example: dashboard.example.com).
# Unknown Host values are dropped before the API key is attached.
# LINKMESH_SERVER_NAMES=
