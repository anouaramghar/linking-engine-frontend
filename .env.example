# Keep API calls same-origin so Vite (development) or the web server (deployment)
# can proxy them to the backend without browser CORS configuration.
VITE_API_BASE_URL=/api

# Server-side proxy settings. LINKMESH_API_KEY must never use the VITE_ prefix:
# Vite exposes every VITE_ variable to browser JavaScript.
BACKEND_URL=http://127.0.0.1:8000
LINKMESH_API_KEY=
